<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--
        Uploads must work in a release build. Flutter's generated project declares
        INTERNET only in the debug and profile source sets (where the tool needs it
        for hot reload), so a release APK would ship without it and every upload
        attempt in FLT-SYNC-* would fail on a permission error rather than on a
        network condition. Declared here so the release build has it too.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!--
        Advisory connectivity signal only (connectivity_plus). Link state is never
        treated as proof of reachability - the upload attempt is authoritative.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!--
        CAMERA is contributed by the camera plugin's own manifest and merged in.
        It is declared explicitly here so the app's own required hardware and
        permissions are readable in one place.
    -->
    <uses-permission android:name="android.permission.CAMERA"/>

    <!--
        The camera plugin declares audio and legacy shared-storage permissions
        for its general video/file API. PresenceLens captures still images with
        enableAudio=false and persists them only in app-private storage.
    -->
    <uses-permission
        android:name="android.permission.RECORD_AUDIO"
        tools:node="remove"/>
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove"/>
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:node="remove"/>

    <!--
        Ordinary constrained WorkManager jobs do not need a notification
        permission. Revisit this only if the app intentionally adds a
        user-visible long-running foreground worker.
    -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"
        tools:node="remove"/>

    <!--
        The app is useful only with a camera, but it must still install and
        degrade gracefully on a device without one (FLT-ERR-*), so this is
        declared not-required rather than filtering the app out of the store.
    -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.any" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>

    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
