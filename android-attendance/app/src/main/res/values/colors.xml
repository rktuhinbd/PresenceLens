<?xml version="1.0" encoding="utf-8"?>
<!--
    The app's palette lives in Compose (ui/theme/Color.kt), not here. This file keeps only
    what the platform reads before the first frame is composed.
-->
<resources>
    <!-- Painted by the system while the Activity window is created, so it must match the
         Compose background to avoid a flash of a different colour on cold start. -->
    <color name="window_background">#FFFBF8FF</color>
    <color name="window_background_dark">#FF121318</color>
</resources>
